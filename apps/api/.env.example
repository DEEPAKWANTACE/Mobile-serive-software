NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://USER@localhost:5432/msm_dev

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed web origins
CORS_ORIGIN=http://localhost:5173

# Initial Super Admin created by `npm run db:seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-now

# Uploaded photos (private). Relative to apps/api.
UPLOAD_DIR=uploads
APP_TIMEZONE=Asia/Kolkata

# Encrypts stored device unlock codes. Long random string; never change once data exists.
# DATA_ENCRYPTION_KEY=
