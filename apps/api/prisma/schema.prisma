// Foundation schema: organisation hierarchy, users/auth, audit trail.
// Business modules (job sheets, inventory, billing, ...) are added in later migrations.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  BRANCH_MANAGER
  CCO
  ENGINEER
  STOREKEEPER
  ACCOUNTS
}

enum BranchType {
  SERVICE_CENTER
  MAIN_OFFICE // L4 / central repair centre that receives transfers
}

// ─── Organisation hierarchy: State → City → Branch ──────────────────────────

model State {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  code      String   @unique // e.g. "MH", "DL"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cities City[]

  @@map("states")
}

model City {
  id        String   @id @default(uuid(7)) @db.Uuid
  stateId   String   @map("state_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  state    State    @relation(fields: [stateId], references: [id])
  branches Branch[]

  @@unique([stateId, name])
  @@map("cities")
}

model Branch {
  stockTransfersOut StockTransfer[] @relation("StockTransferFrom")
  stockTransfersIn  StockTransfer[] @relation("StockTransferTo")
  jobsHere          Job[]           @relation("JobCurrentBranch")
  movementsOut      JobMovement[]   @relation("MovementFrom")
  movementsIn       JobMovement[]   @relation("MovementTo")
  expenses          Expense[]
  callLogs          CallLog[]
  invoices          Invoice[]
  partStocks        PartStock[]
  stockMovements    StockMovement[]
  id                String          @id @default(uuid(7)) @db.Uuid
  cityId            String          @map("city_id") @db.Uuid
  code              String          @unique // short code, used as job-number prefix
  name              String
  type              BranchType      @default(SERVICE_CENTER)
  address           String?
  phone             String?
  isActive          Boolean         @default(true) @map("is_active")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  city        City         @relation(fields: [cityId], references: [id])
  users       User[]
  jobs        Job[]
  jobCounters JobCounter[]
  payments    Payment[]

  @@index([cityId])
  @@map("branches")
}

// ─── Users & authentication ─────────────────────────────────────────────────

model User {
  passwordChangedAt      DateTime?          @map("password_changed_at")
  jobsInwarded           Job[]              @relation("JobInwardBy")
  statusChanges          JobStatusHistory[] @relation("StatusChangedBy")
  statusAsEngineer       JobStatusHistory[] @relation("StatusEngineer")
  assignmentsHeld        JobAssignment[]    @relation("AssignmentEngineer")
  assignmentsMade        JobAssignment[]    @relation("AssignmentBy")
  stockTransfersSent     StockTransfer[]    @relation("StockTransferSentBy")
  stockTransfersReceived StockTransfer[]    @relation("StockTransferReceivedBy")
  movementsSent          JobMovement[]      @relation("MovementSentBy")
  movementsReceived      JobMovement[]      @relation("MovementReceivedBy")
  expensesCreated        Expense[]          @relation("ExpenseCreatedBy")
  expensesVoided         Expense[]          @relation("ExpenseVoidedBy")
  callLogs               CallLog[]
  jobsDelivered          Job[]              @relation("JobDeliveredBy")
  invoicesCreated        Invoice[]
  stockMovements         StockMovement[]
  partsRequested         JobPart[]          @relation("JobPartRequestedBy")
  partsHandled           JobPart[]          @relation("JobPartHandledBy")
  id                     String             @id @default(uuid(7)) @db.Uuid
  name                   String
  username               String             @unique
  phone                  String?            @unique
  email                  String?            @unique
  passwordHash           String             @map("password_hash")
  role                   Role
  address                String?
  /// 12-digit Aadhaar (staff KYC). Shown masked except to managers.
  aadhaarNumber          String?            @map("aadhaar_number")
  aadhaarPhotoKey        String?            @map("aadhaar_photo_key")
  /// Null only for global roles (SUPER_ADMIN).
  branchId               String?            @map("branch_id") @db.Uuid
  isActive               Boolean            @default(true) @map("is_active")
  lastLoginAt            DateTime?          @map("last_login_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  branch       Branch?       @relation(fields: [branchId], references: [id])
  sessions     Session[]
  auditLogs    AuditLog[]
  jobsCreated  Job[]         @relation("JobCreatedBy")
  jobsAssigned Job[]         @relation("JobAssignedEngineer")
  jobsApproved Job[]         @relation("JobApprovedBy")
  transfersOut JobTransfer[] @relation("TransferFrom")
  transfersIn  JobTransfer[] @relation("TransferTo")
  jobPhotos    JobPhoto[]
  payments     Payment[]

  @@index([branchId, role])
  @@map("users")
}

/// One row per refresh token. Rotated on every refresh; reuse of a revoked token revokes the family.
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─── Audit trail ────────────────────────────────────────────────────────────

/// Append-only log of significant actions. Job history will be built on top of this.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String // e.g. "auth.login", "job.status_changed"
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  branchId   String?  @map("branch_id") @db.Uuid
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([branchId, createdAt])
  @@map("audit_logs")
}

// ─── Device catalogue & pricing ─────────────────────────────────────────────

model Brand {
  parts     Part[]
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  models DeviceModel[]
  jobs   Job[]

  @@map("brands")
}

model DeviceModel {
  parts     Part[]
  id        String   @id @default(uuid(7)) @db.Uuid
  brandId   String   @map("brand_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brand  Brand          @relation(fields: [brandId], references: [id])
  prices ServicePrice[]
  jobs   Job[]

  @@unique([brandId, name])
  @@map("device_models")
}

/// Groups faults for quicker selection, e.g. "Battery" → "Not charging", "No backup".
model FaultCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  faults Fault[]

  @@map("fault_categories")
}

/// Problem / fault / service type the customer reports or the engineer diagnoses.
model Fault {
  id              String   @id @default(uuid(7)) @db.Uuid
  categoryId      String?  @map("category_id") @db.Uuid
  name            String   @unique
  description     String?
  /// Jobs with this fault (e.g. software unlock) need the customer's Aadhaar/ID photo.
  requiresIdProof Boolean  @default(false) @map("requires_id_proof")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  category      FaultCategory?    @relation(fields: [categoryId], references: [id])
  prices        ServicePrice[]
  jobFaults     JobFault[]
  estimateLines JobEstimateLine[]

  @@index([categoryId])
  @@map("faults")
}

/// Price option for a model + fault, e.g. Screen: "Copy" 1000 / "OG" 2000 / "Original" 3000.
/// Estimates copy label and amount, so rows can be changed freely.
model ServicePrice {
  id            String   @id @default(uuid(7)) @db.Uuid
  deviceModelId String   @map("device_model_id") @db.Uuid
  faultId       String   @map("fault_id") @db.Uuid
  label         String   @default("Standard")
  price         Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  deviceModel DeviceModel @relation(fields: [deviceModelId], references: [id], onDelete: Cascade)
  fault       Fault       @relation(fields: [faultId], references: [id])

  @@unique([deviceModelId, faultId, label])
  @@index([faultId])
  @@map("service_prices")
}

// ─── Customers & job sheets ─────────────────────────────────────────────────

/// Customers are shared across branches and identified by mobile number.
model Customer {
  city      String?
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  phone     String   @unique
  altPhone  String?  @map("alt_phone")
  email     String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jobs Job[]

  @@map("customers")
}

/// Workflow status. Values are added as each workflow module is built.
enum JobStatus {
  RECEIVED // job sheet created by CCO, awaiting engineer assignment
  ASSIGNED // with engineer, pending diagnosis
  AWAITING_APPROVAL // engineer quoted more than the customer agreed; CCO must call the customer
  IN_REPAIR // approved (or within agreed estimate) — engineer repairing
  CUSTOMER_REJECTED // customer declined the quote; phone to be returned unrepaired
  REPAIRED // "Done": repaired, still with engineer
  TESTING // engineer testing the repaired phone
  READY_FOR_DELIVERY // "Returned OK": handed back to the counter
  SPARE_PENDING // "Spare not available": waiting for a part
  RWR // returned without repair (reason + photos recorded)
  DELIVERED // handed back to the customer; job closed
  CANCELLED // cancelled by the counter (reason recorded); job closed
}

enum WarrantyStatus {
  IN_WARRANTY
  OUT_OF_WARRANTY
}

enum AssignmentEndReason {
  REASSIGNED // admin moved it to another engineer
  TRANSFERRED // engineer-to-engineer transfer accepted
  UNASSIGNED // returned to the counter / admin
  SENT_TO_L4
  CLOSED // delivered or cancelled
}

/// Where the phone physically is. The owning branch (`branchId`) never changes; `currentBranchId` follows the phone.
enum JobLocation {
  AT_BRANCH // at the branch that currently works on it
  TO_L4 // in transit to the main office
  TO_BRANCH // in transit back to the owning branch
}

enum RwrReason {
  SPARE_NOT_AVAILABLE
  NOT_REPAIRABLE // e.g. already tampered by other shops
  CUSTOMER_REJECTED
  OTHER
}

enum TransferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model Job {
  /// Dealer / shopkeeper who brought the phone (if not walk-in).
  retailer           String?
  /// Staff member who physically took the phone in (defaults to the creator).
  inwardById         String?            @map("inward_by_id") @db.Uuid
  phoneDamaged       Boolean            @default(false) @map("phone_damaged")
  warranty           WarrantyStatus?
  /// Device unlock code / pattern, encrypted at rest (AES-256-GCM).
  devicePasswordEnc  String?            @map("device_password_enc")
  repairRemark       String?            @map("repair_remark")
  testingRemark      String?            @map("testing_remark")
  testingAt          DateTime?          @map("testing_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  cancelReason       String?            @map("cancel_reason")
  inwardBy           User?              @relation("JobInwardBy", fields: [inwardById], references: [id])
  statusHistory      JobStatusHistory[]
  assignments        JobAssignment[]
  /// Branch that has the phone / works on it now (= branchId unless sent to L4).
  currentBranchId    String             @map("current_branch_id") @db.Uuid
  location           JobLocation        @default(AT_BRANCH)
  currentBranch      Branch             @relation("JobCurrentBranch", fields: [currentBranchId], references: [id])
  movements          JobMovement[]
  callLogs           CallLog[]
  deliveredAt        DateTime?          @map("delivered_at")
  deliveredById      String?            @map("delivered_by_id") @db.Uuid
  /// Name of the person who collected the phone (customer or someone on their behalf).
  deliveredTo        String?            @map("delivered_to")
  deliveryNote       String?            @map("delivery_note")
  deliveredBy        User?              @relation("JobDeliveredBy", fields: [deliveredById], references: [id])
  invoice            Invoice?
  parts              JobPart[]
  stockMovements     StockMovement[]
  id                 String             @id @default(uuid(7)) @db.Uuid
  jobNumber          String             @unique @map("job_number") // e.g. AND01-2610-0001
  branchId           String             @map("branch_id") @db.Uuid
  customerId         String             @map("customer_id") @db.Uuid
  brandId            String             @map("brand_id") @db.Uuid
  deviceModelId      String             @map("device_model_id") @db.Uuid
  imei               String?
  serialNumber       String?            @map("serial_number")
  color              String?
  customerComplaint  String?            @map("customer_complaint")
  conditionNotes     String?            @map("condition_notes")
  accessories        String[]
  accessoriesOther   String?            @map("accessories_other")
  /// Sum of the price options chosen at intake; null when cost is unknown (e.g. dead phone).
  estimatedAmount    Decimal?           @map("estimated_amount") @db.Decimal(10, 2)
  status             JobStatus          @default(RECEIVED)
  assignedEngineerId String?            @map("assigned_engineer_id") @db.Uuid
  assignedAt         DateTime?          @map("assigned_at")
  diagnosisNotes     String?            @map("diagnosis_notes")
  diagnosedAt        DateTime?          @map("diagnosed_at")
  /// Current total of the engineer's estimate lines.
  quotedAmount       Decimal?           @map("quoted_amount") @db.Decimal(10, 2)
  /// Amount the customer has agreed to (intake estimate or explicit approval).
  approvedAmount     Decimal?           @map("approved_amount") @db.Decimal(10, 2)
  approvedAt         DateTime?          @map("approved_at")
  approvedById       String?            @map("approved_by_id") @db.Uuid
  customerResponse   String?            @map("customer_response")
  repairedAt         DateTime?          @map("repaired_at")
  readyAt            DateTime?          @map("ready_at")
  sparePart          String?            @map("spare_part")
  spareRequestedAt   DateTime?          @map("spare_requested_at")
  /// Status to resume when the spare arrives.
  statusBeforeHold   JobStatus?         @map("status_before_hold")
  rwrReason          RwrReason?         @map("rwr_reason")
  rwrNote            String?            @map("rwr_note")
  rwrAt              DateTime?          @map("rwr_at")
  createdById        String             @map("created_by_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  branch           Branch            @relation(fields: [branchId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  brand            Brand             @relation(fields: [brandId], references: [id])
  deviceModel      DeviceModel       @relation(fields: [deviceModelId], references: [id])
  createdBy        User              @relation("JobCreatedBy", fields: [createdById], references: [id])
  assignedEngineer User?             @relation("JobAssignedEngineer", fields: [assignedEngineerId], references: [id])
  approvedBy       User?             @relation("JobApprovedBy", fields: [approvedById], references: [id])
  estimateLines    JobEstimateLine[]
  faults           JobFault[]
  photos           JobPhoto[]
  payments         Payment[]
  transfers        JobTransfer[]

  @@index([branchId, createdAt])
  @@index([branchId, status])
  @@index([customerId])
  @@index([imei])
  @@index([assignedEngineerId, status])
  @@index([currentBranchId, status])
  @@map("jobs")
}

/// Faults reported at intake.
model JobFault {
  jobId      String   @map("job_id") @db.Uuid
  faultId    String   @map("fault_id") @db.Uuid
  /// Snapshot of the chosen price option at intake (null = cost to be decided).
  priceLabel String?  @map("price_label")
  price      Decimal? @db.Decimal(10, 2)

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fault Fault @relation(fields: [faultId], references: [id])

  @@id([jobId, faultId])
  @@map("job_faults")
}

/// Per-branch, per-month running sequence used to build job numbers.
model JobCounter {
  branchId String @map("branch_id") @db.Uuid
  period   String // YYMM
  lastSeq  Int    @map("last_seq")

  branch Branch @relation(fields: [branchId], references: [id])

  @@id([branchId, period])
  @@map("job_counters")
}

enum PhotoKind {
  CUSTOMER
  ID_PROOF // Aadhaar or other ID
  DEVICE
  RWR // motherboard / internal condition proof when returned without repair
}

/// Private image stored via the storage driver; served only through an authorised endpoint.
model JobPhoto {
  id           String    @id @default(uuid(7)) @db.Uuid
  jobId        String    @map("job_id") @db.Uuid
  kind         PhotoKind
  storageKey   String    @unique @map("storage_key")
  mimeType     String    @map("mime_type")
  sizeBytes    Int       @map("size_bytes")
  uploadedById String    @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  job        Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([jobId])
  @@map("job_photos")
}

// ─── Payments ───────────────────────────────────────────────────────────────

enum PaymentMode {
  CASH
  UPI
  CARD
}

enum PaymentKind {
  ADVANCE // taken at intake
  FINAL // taken at delivery
  REFUND // money returned to the customer (stored as a positive amount)
}

/// Money received against a job. Revenue reports sum these by date/branch.
model Payment {
  invoiceId    String?     @map("invoice_id") @db.Uuid
  invoice      Invoice?    @relation(fields: [invoiceId], references: [id])
  id           String      @id @default(uuid(7)) @db.Uuid
  jobId        String      @map("job_id") @db.Uuid
  branchId     String      @map("branch_id") @db.Uuid
  kind         PaymentKind
  mode         PaymentMode
  amount       Decimal     @db.Decimal(10, 2)
  reference    String? // UPI / card transaction reference
  receivedById String      @map("received_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at")

  job        Job    @relation(fields: [jobId], references: [id])
  branch     Branch @relation(fields: [branchId], references: [id])
  receivedBy User   @relation(fields: [receivedById], references: [id])

  @@index([jobId])
  @@index([branchId, createdAt])
  @@map("payments")
}

/// Engineer's diagnosis / quote line: a fault (optionally a price option) or a custom item, with its amount.
model JobEstimateLine {
  partId      String? @map("part_id") @db.Uuid
  part        Part?   @relation(fields: [partId], references: [id])
  id          String  @id @default(uuid(7)) @db.Uuid
  jobId       String  @map("job_id") @db.Uuid
  faultId     String? @map("fault_id") @db.Uuid
  description String? // free text, e.g. "IC level issue"
  priceLabel  String? @map("price_label")
  amount      Decimal @db.Decimal(10, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fault Fault? @relation(fields: [faultId], references: [id])

  @@index([jobId])
  @@map("job_estimate_lines")
}

/// Engineer-to-engineer hand-over. The job moves only when the receiving engineer accepts.
model JobTransfer {
  remark         String?
  id             String         @id @default(uuid(7)) @db.Uuid
  jobId          String         @map("job_id") @db.Uuid
  fromEngineerId String         @map("from_engineer_id") @db.Uuid
  toEngineerId   String         @map("to_engineer_id") @db.Uuid
  reason         String
  status         TransferStatus @default(PENDING)
  responseNote   String?        @map("response_note")
  /// When the job reached the sending engineer (to measure how long they held it).
  heldSince      DateTime       @map("held_since")
  createdAt      DateTime       @default(now()) @map("created_at")
  respondedAt    DateTime?      @map("responded_at")

  job          Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromEngineer User @relation("TransferFrom", fields: [fromEngineerId], references: [id])
  toEngineer   User @relation("TransferTo", fields: [toEngineerId], references: [id])

  @@index([jobId, status])
  @@index([toEngineerId, status])
  @@map("job_transfers")
}

// ─── Spare-part inventory ───────────────────────────────────────────────────

/// Spare part master. Staff refer to parts by `code` (e.g. "105" = a display), so nobody needs to know every part by name.
model Part {
  stockTransfers StockTransfer[]
  id             String          @id @default(uuid(7)) @db.Uuid
  code           String          @unique
  name           String
  brandId        String?         @map("brand_id") @db.Uuid
  deviceModelId  String?         @map("device_model_id") @db.Uuid
  /// Price charged to the customer.
  sellingPrice   Decimal         @map("selling_price") @db.Decimal(10, 2)
  /// Purchase cost (for margin reports).
  costPrice      Decimal?        @map("cost_price") @db.Decimal(10, 2)
  /// Highlight as low stock at or below this quantity.
  reorderLevel   Int             @default(1) @map("reorder_level")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  brand         Brand?            @relation(fields: [brandId], references: [id])
  deviceModel   DeviceModel?      @relation(fields: [deviceModelId], references: [id])
  stocks        PartStock[]
  movements     StockMovement[]
  jobParts      JobPart[]
  estimateLines JobEstimateLine[]

  @@index([deviceModelId])
  @@map("parts")
}

/// Current quantity of a part at a branch (kept in step with the movement ledger).
model PartStock {
  partId   String @map("part_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  quantity Int    @default(0)

  part   Part   @relation(fields: [partId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@id([partId, branchId])
  @@map("part_stocks")
}

enum StockMovementType {
  RECEIPT // stock in (purchase / transfer in)
  ISSUE // issued to a job
  RETURN // returned from a job to stock
  ADJUSTMENT // manual correction (count, damage, loss)
  TRANSFER_OUT // sent to another branch
  TRANSFER_IN // received from another branch (or a cancelled transfer coming back)
}

/// Append-only stock ledger. `quantity` is signed; `balanceAfter` is the branch quantity after this movement.
model StockMovement {
  id           String            @id @default(uuid(7)) @db.Uuid
  partId       String            @map("part_id") @db.Uuid
  branchId     String            @map("branch_id") @db.Uuid
  type         StockMovementType
  quantity     Int
  balanceAfter Int               @map("balance_after")
  unitCost     Decimal?          @map("unit_cost") @db.Decimal(10, 2)
  jobId        String?           @map("job_id") @db.Uuid
  reference    String? // supplier invoice no. etc.
  note         String?
  createdById  String            @map("created_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at")

  part      Part   @relation(fields: [partId], references: [id])
  branch    Branch @relation(fields: [branchId], references: [id])
  job       Job?   @relation(fields: [jobId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([branchId, createdAt])
  @@index([partId, branchId, createdAt])
  @@map("stock_movements")
}

enum JobPartStatus {
  REQUESTED // engineer asked the store
  ISSUED // handed to engineer; stock reduced
  NOT_AVAILABLE // store has none; job waits (can still be issued when stock arrives)
  RETURNED // unused part back to stock
  CANCELLED
}

/// A part requested for / used on a job.
model JobPart {
  id            String        @id @default(uuid(7)) @db.Uuid
  jobId         String        @map("job_id") @db.Uuid
  partId        String        @map("part_id") @db.Uuid
  quantity      Int
  /// Selling price at the time of request.
  unitPrice     Decimal       @map("unit_price") @db.Decimal(10, 2)
  status        JobPartStatus @default(REQUESTED)
  note          String?
  requestedById String        @map("requested_by_id") @db.Uuid
  requestedAt   DateTime      @default(now()) @map("requested_at")
  handledById   String?       @map("handled_by_id") @db.Uuid
  handledAt     DateTime?     @map("handled_at")

  job         Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  part        Part  @relation(fields: [partId], references: [id])
  requestedBy User  @relation("JobPartRequestedBy", fields: [requestedById], references: [id])
  handledBy   User? @relation("JobPartHandledBy", fields: [handledById], references: [id])

  @@index([jobId])
  @@index([status, requestedAt])
  @@map("job_parts")
}

// ─── Billing ────────────────────────────────────────────────────────────────

/// Bill raised when a job is delivered. One invoice per job; lines are a snapshot.
model Invoice {
  id             String   @id @default(uuid(7)) @db.Uuid
  invoiceNumber  String   @unique @map("invoice_number") // e.g. INV-KOR01-2610-0001
  jobId          String   @unique @map("job_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  subtotal       Decimal  @db.Decimal(10, 2)
  discount       Decimal  @default(0) @db.Decimal(10, 2)
  discountReason String?  @map("discount_reason")
  total          Decimal  @db.Decimal(10, 2)
  createdById    String   @map("created_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  job       Job           @relation(fields: [jobId], references: [id])
  branch    Branch        @relation(fields: [branchId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])
  lines     InvoiceLine[]
  payments  Payment[]

  @@index([branchId, createdAt])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid(7)) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  description String
  amount      Decimal @db.Decimal(10, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

// ─── Accounts: office expenses ──────────────────────────────────────────────

/// Money paid out of the branch (tea, travel, courier…). Never deleted — voided with a reason.
model Expense {
  id          String      @id @default(uuid(7)) @db.Uuid
  branchId    String      @map("branch_id") @db.Uuid
  category    String
  description String
  amount      Decimal     @db.Decimal(10, 2)
  mode        PaymentMode
  /// Business date the expense belongs to (YYYY-MM-DD in the business timezone).
  expenseDate String      @map("expense_date")
  createdById String      @map("created_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  voidedAt    DateTime?   @map("voided_at")
  voidedById  String?     @map("voided_by_id") @db.Uuid
  voidReason  String?     @map("void_reason")

  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User   @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  voidedBy  User?  @relation("ExpenseVoidedBy", fields: [voidedById], references: [id])

  @@index([branchId, expenseDate])
  @@map("expenses")
}

// ─── Customer calling ("happy calling") ─────────────────────────────────────

enum CallPurpose {
  READY_PICKUP // phone repaired, please collect
  RWR_PICKUP // phone not repaired, please collect
  APPROVAL // estimate approval
  FOLLOW_UP
  OTHER
}

enum CallOutcome {
  WILL_COLLECT // answered, will come
  CALL_LATER // answered, asked to call later
  NOT_ANSWERED
  SWITCHED_OFF
  WRONG_NUMBER
  OTHER
}

model CallLog {
  id             String      @id @default(uuid(7)) @db.Uuid
  jobId          String      @map("job_id") @db.Uuid
  branchId       String      @map("branch_id") @db.Uuid
  purpose        CallPurpose
  outcome        CallOutcome
  note           String?
  /// When to call again / when the customer promised to come.
  nextFollowUpAt DateTime?   @map("next_follow_up_at")
  createdById    String      @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")

  job       Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([jobId, createdAt])
  @@index([branchId, nextFollowUpAt])
  @@map("call_logs")
}

// ─── L4 / main-office transfers ─────────────────────────────────────────────

enum MovementDirection {
  TO_L4
  TO_BRANCH
}

/// Physical movement of a phone between a branch and the main office (L4).
model JobMovement {
  id           String            @id @default(uuid(7)) @db.Uuid
  jobId        String            @map("job_id") @db.Uuid
  direction    MovementDirection
  fromBranchId String            @map("from_branch_id") @db.Uuid
  toBranchId   String            @map("to_branch_id") @db.Uuid
  reason       String?
  sentById     String            @map("sent_by_id") @db.Uuid
  sentAt       DateTime          @default(now()) @map("sent_at")
  receivedById String?           @map("received_by_id") @db.Uuid
  receivedAt   DateTime?         @map("received_at")
  receiveNote  String?           @map("receive_note")

  job        Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromBranch Branch @relation("MovementFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch @relation("MovementTo", fields: [toBranchId], references: [id])
  sentBy     User   @relation("MovementSentBy", fields: [sentById], references: [id])
  receivedBy User?  @relation("MovementReceivedBy", fields: [receivedById], references: [id])

  @@index([jobId, sentAt])
  @@index([toBranchId, receivedAt])
  @@index([fromBranchId, sentAt])
  @@map("job_movements")
}

enum StockTransferStatus {
  SENT // stock left the sending branch; in transit
  RECEIVED
  CANCELLED // sender cancelled before receipt; stock returned to sender
}

/// Parts moving between branch stores. Stock leaves on send and arrives on receive.
model StockTransfer {
  id           String              @id @default(uuid(7)) @db.Uuid
  partId       String              @map("part_id") @db.Uuid
  fromBranchId String              @map("from_branch_id") @db.Uuid
  toBranchId   String              @map("to_branch_id") @db.Uuid
  quantity     Int
  status       StockTransferStatus @default(SENT)
  note         String?
  sentById     String              @map("sent_by_id") @db.Uuid
  sentAt       DateTime            @default(now()) @map("sent_at")
  receivedById String?             @map("received_by_id") @db.Uuid
  receivedAt   DateTime?           @map("received_at")

  part       Part   @relation(fields: [partId], references: [id])
  fromBranch Branch @relation("StockTransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch @relation("StockTransferTo", fields: [toBranchId], references: [id])
  sentBy     User   @relation("StockTransferSentBy", fields: [sentById], references: [id])
  receivedBy User?  @relation("StockTransferReceivedBy", fields: [receivedById], references: [id])

  @@index([toBranchId, status])
  @@index([fromBranchId, status])
  @@map("stock_transfers")
}

// ─── Shop / company settings (single row, id = "default") ───────────────────

/// Business identity printed on invoices and job sheets.
model ShopSettings {
  id           String   @id @default("default")
  shopName     String   @map("shop_name")
  legalName    String?  @map("legal_name")
  gstin        String?
  address      String?
  phone        String?
  email        String?
  logoKey      String?  @map("logo_key")
  invoiceTerms String?  @map("invoice_terms")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("shop_settings")
}

// ─── Job history (status & engineer assignment) ─────────────────────────────

/// One row per status change of a job: who changed it, which engineer had it, and why.
model JobStatusHistory {
  id          BigInt     @id @default(autoincrement())
  jobId       String     @map("job_id") @db.Uuid
  fromStatus  JobStatus? @map("from_status")
  toStatus    JobStatus  @map("to_status")
  /// Engineer holding the job when the change happened.
  engineerId  String?    @map("engineer_id") @db.Uuid
  changedById String?    @map("changed_by_id") @db.Uuid
  remark      String?
  changedAt   DateTime   @default(now()) @map("changed_at")

  job       Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  engineer  User? @relation("StatusEngineer", fields: [engineerId], references: [id])
  changedBy User? @relation("StatusChangedBy", fields: [changedById], references: [id])

  @@index([jobId, changedAt])
  @@index([engineerId, changedAt])
  @@index([toStatus, changedAt])
  @@map("job_status_history")
}

/// Engineer assignment periods of a job. A new row starts on every (re)assignment / accepted transfer;
/// the previous row is closed with the reason, so the full chain (A → B → admin) is kept.
model JobAssignment {
  id           String               @id @default(uuid(7)) @db.Uuid
  jobId        String               @map("job_id") @db.Uuid
  engineerId   String               @map("engineer_id") @db.Uuid
  assignedById String?              @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime             @default(now()) @map("assigned_at")
  endedAt      DateTime?            @map("ended_at")
  endReason    AssignmentEndReason? @map("end_reason")
  note         String?

  job        Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  engineer   User  @relation("AssignmentEngineer", fields: [engineerId], references: [id])
  assignedBy User? @relation("AssignmentBy", fields: [assignedById], references: [id])

  @@index([jobId, assignedAt])
  @@index([engineerId, endedAt])
  @@map("job_assignments")
}
